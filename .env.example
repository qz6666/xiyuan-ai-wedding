DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# The same Volcengine Ark key is used for Doubao Seedream images and Seedance video.
ARK_API_KEY=
ARK_IMAGE_MODEL=doubao-seedream-5-0-260128
ARK_VIDEO_MODEL=doubao-seedance-2-0-260128

# Account verification and password reset emails (Resend).
RESEND_API_KEY=
AUTH_EMAIL_FROM=喜缘 <no-reply@your-domain.com>

# Optional notification gateways. SMS accepts a generic JSON webhook;
# WeChat accepts a bot-compatible JSON webhook.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
WECHAT_WEBHOOK_URL=
WECHAT_WEBHOOK_TOKEN=

# Optional Stripe subscription checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_STUDIO_PRICE_ID=
# Comma-separated emails allowed to open the operations dashboard.
ADMIN_EMAILS=admin@example.com

# Legal operator information shown in the privacy and terms pages.
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_ADDRESS=

# Optional webhook for critical runtime incidents.
OPERATIONS_ALERT_WEBHOOK_URL=
OPERATIONS_ALERT_WEBHOOK_TOKEN=
